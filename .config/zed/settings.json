// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // === Keymap ===
  "cli_default_open_behavior": "new_window",
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "on_last_window_closed": "quit_app",
  "agent": {
    "dock": "right",
    "play_sound_when_agent_done": "always",
    "default_model": {
      "provider": "ollama",
      "model": "qwen3.6:35b",
      "enable_thinking": true,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "base_keymap": "JetBrains",

  // === Font & Typography ===
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_size": 17.0,
  "buffer_line_height": {
    "custom": 2.0,
  },
  "buffer_font_features": {
    "liga": true,
  },

  // === Theme & Icons ===
  "theme": {
    "mode": "system",
    "light": "Catppuccin Frappé",
    "dark": "Catppuccin Macchiato",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Frappé",
    "dark": "Catppuccin Macchiato",
  },

  // === UI ===
  "use_system_window_tabs": true,
  "tab_bar": {
    "show": true,
  },
  "title_bar": {
    "show_branch_name": true,
    "show_menus": true,
    "show_sign_in": false,
    "show_onboarding_banner": false,
    "show_project_items": true,
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": true,
  },
  "scrollbar": {
    "show": "auto",
  },
  "gutter": {
    "line_numbers": true,
    "folds": true,
  },
  "minimap": {
    "show": "never",
  },
  "tabs": {
    "git_status": true,
    "file_icons": true,
    "show_diagnostics": "errors",
  },
  "project_panel": {
    "dock": "left",
    "button": true,
    "default_width": 280,
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
  },

  // === Editor Features ===
  "restore_on_startup": "empty_tab",
  "wrap_guides": [140],
  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 1,
    "coloring": "fixed",
    "background_coloring": "disabled",
  },
  "inlay_hints": {
    "enabled": true,
  },
  "sticky_scroll": {
    "enabled": true,
  },
  "show_edit_predictions": true,
  "edit_predictions": {
    "ollama": {
      "model": "qwen3.6:35b",
    },
    "provider": "ollama",
  },
  "diagnostics": {
    "button": false,
  },

  // === Git ===
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },

  // === Language & Formatting ===
  "languages": {
    "PHP": {
      // Recommended: Format your code automatically whenever you save a file.
      "format_on_save": "on",
      "language_servers": [
        "laravel-lsp",
        "intelephense",
        "!phpactor",
        "!phptools",
        "...",
      ],
      // LSP outlines: our route-file outline + your PHP LSP's class outline.
      // "on" | "off"                                            Default: "off"
      "document_symbols": "on",
      // Configure Mago as the external formatter.
      "formatter": {
        "external": {
          "command": "mago",
          "arguments": ["format", "--stdin-input"],
        },
      },
    },
    // ... other language settings
    "Blade": {
      // Same rules as PHP. "!phpactor" stops the PHP-oriented Phpactor server
      // from also attaching to .blade.php files and double-reporting.
      "language_servers": ["laravel-lsp", "!phpactor", "..."],
      // Our Blade outline (@extends / @section / <x-*> / <livewire:*> …).
      "document_symbols": "on",
      // Highlight custom inline @directive() macros tree-sitter can't see
      // (e.g. a @money($x) Blade::directive). Requires Zed semantic-token
      // support; "combined" overlays them on the Blade extension's colors.
      "semantic_tokens": "combined",
    },
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "php": "html",
        },
        "experimental": {
          "classRegex": [
            "class=\"([^\"]*)\"",
            "class='([^']*)'",
            "class=\\\"([^\\\"]*)\\\"",
          ],
        },
      },
    },
    // Trim Intelephense goto-definition noise. This extension resolves facades,
    // macros & mixins to their concrete implementation, so the generated IDE-helper
    // stubs (and the PhpStorm meta file) only add duplicate facade/Eloquent hits to
    // the goto multibuffer. Excluding them lets our resolution stand alone.
    // Trade-off: Intelephense then loses completion for *package-added* facade
    // methods (Scout, Telescope, Spatie…); core facade completion is unaffected
    // (it reads framework docblocks, not the helper). Full rationale, the cache
    // caveat, and a per-project `.intelephense.json` variant: docs/tuning-intelephense.md.
    // Restart after editing (Cmd+Shift+P → "lsp: restart").
    "intelephense": {
      "settings": {
        "files": {
          "exclude": [
            "**/stubs/**", // scaffold templates (Jetstream, Filament…), never run
            "**/_ide_helper*.php", // barryvdh/laravel-ide-helper facade + model stubs
            "**/.phpstorm.meta.php", // PhpStorm container-binding type hints
          ],
        },
      },
    },
  },
  "prettier": {
    "allowed": true,
  },

  // === Terminal ===
  "terminal": {
    "button": false,
    "font_family": "MesloLGM Nerd Font Mono",
    "font_size": 17,
    "line_height": {
      "custom": 1.5,
    },
    "dock": "bottom",
  },

  // === Integrations ===
  "context_servers": {
    "mcp-server-context7": {
      "enabled": true,
      "settings": {
        "default_minimum_tokens": "10000",
      },
    },
  },

  // === System ===
  "telemetry": {
    "diagnostics": false,
    "metrics": true,
  },
}
