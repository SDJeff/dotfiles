// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // === Keymap ===
  "on_last_window_closed": "quit_app",
  "agent": {
    "default_model": {
      "provider": "ollama",
      "model": "qwen3:latest",
      "enable_thinking": true
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "base_keymap": "JetBrains",

  // === Font & Typography ===
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_size": 17.0,
  "buffer_line_height": {
    "custom": 2.0,
  },
  "buffer_font_features": {
    "liga": true,
  },

  // === Theme & Icons ===
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Macchiato",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Frappé",
    "dark": "Catppuccin Macchiato",
  },

  // === UI ===
  "use_system_window_tabs": true,
  "tab_bar": {
    "show": false,
  },
  "title_bar": {
    "show_branch_name": true,
    "show_branch_icon": false,
    "show_menus": true,
    "show_sign_in": false,
    "show_onboarding_banner": false,
    "show_project_items": true,
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": true,
  },
  "scrollbar": {
    "show": "auto",
  },
  "gutter": {
    "line_numbers": true,
    "folds": true,
  },
  "minimap": {
    "show": "never",
  },
  "tabs": {
    "git_status": true,
    "file_icons": true,
    "show_diagnostics": "errors",
  },
  "project_panel": {
    "dock": "left",
    "button": true,
    "default_width": 280,
  },
  "git_panel": {
    "tree_view": true,
  },

  // === Editor Features ===
  "wrap_guides": [140],
  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 1,
    "coloring": "fixed",
    "background_coloring": "disabled",
  },
  "inlay_hints": {
    "enabled": true,
  },
  "sticky_scroll": {
    "enabled": true,
  },
  "show_edit_predictions": true,
  "edit_predictions": {
    "provider": "copilot",
  },
  "diagnostics": {
    "button": false,
  },

  // === Git ===
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },

  // === Language & Formatting ===
  "languages": {
    "PHP": {
      // Recommended: Format your code automatically whenever you save a file.
      "format_on_save": "on",

      // Configure Mago as the external formatter.
      "formatter": {
        "external": {
          "command": "mago",
          "arguments": ["format", "--stdin-input"],
        },
      },
    },
    // ... other language settings
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "php": "html",
        },
        "experimental": {
          "classRegex": [
            "class=\"([^\"]*)\"",
            "class='([^']*)'",
            "class=\\\"([^\\\"]*)\\\"",
          ],
        },
      },
    },
  },
  "prettier": {
    "allowed": true,
  },

  // === Terminal ===
  "terminal": {
    "button": false,
    "font_family": "MesloLGM Nerd Font Mono",
    "font_size": 17,
    "line_height": {
      "custom": 1.5,
    },
    "dock": "bottom",
  },

  // === Integrations ===
  "context_servers": {
    "mcp-server-context7": {
      "enabled": true,
      "settings": {
        "default_minimum_tokens": "10000",
      },
    },
  },

  // === System ===
  "telemetry": {
    "diagnostics": false,
    "metrics": true,
  },
}
